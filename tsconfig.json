{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["jest", "express"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "files": ["src/types/index.d.ts"],
  "include": ["src/**/*",
              "__tests__/**/*"],
  "exclude": ["__tests__", "dist", "node_modules"]
}